{
    "name": "trailscope/trailscope",
    "description": "Trailscope SDK for PHP and Laravel: non-blocking request, job and log capture for a self-hosted Trailscope server.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["trailscope", "logging", "observability", "api", "requests", "laravel", "monitoring"],
    "homepage": "https://github.com/karaa1122/trailscope",
    "support": {
        "issues": "https://github.com/karaa1122/trailscope/issues",
        "docs": "https://github.com/karaa1122/trailscope/blob/main/docs/sdk-laravel.md",
        "source": "https://github.com/karaa1122/trailscope/tree/main/sdks/php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/pint": "1.32.1",
        "monolog/monolog": "^3.12",
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.4"
    },
    "suggest": {
        "ext-curl": "Sends batches with curl and keeps the connection open in long-running processes (falls back to PHP streams)",
        "ext-zlib": "Compresses batches with gzip, and decodes gzip and deflate responses so their bodies can be captured",
        "laravel/framework": "Laravel 10 to 13: middleware, exception capture, queue jobs, log channel and Octane support",
        "monolog/monolog": "Monolog 3: sends log records as Trailscope log events"
    },
    "conflict": {
        "laravel/framework": "<10.0",
        "monolog/monolog": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "Trailscope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trailscope\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Trailscope\\Laravel\\TrailscopeServiceProvider"
            ]
        }
    },
    "scripts": {
        "syntax": "find src config bench tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@syntax",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
